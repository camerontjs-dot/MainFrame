# Public MainFrame product gitignore.
# This file is generated into the public candidate. It is not a copy of the
# private workspace ignore list.

# Generated / runtime
.DS_Store
__pycache__/
*.pyc
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Credentials
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
*.token
.netrc
.mcp.json

# Operator local state
STATE.md

# Lifecycle contents stay local; contracts/templates remain tracked
00_inbox/*
!00_inbox/.gitkeep
!00_inbox/AGENTS.md
01_ingest/ready/*
01_ingest/queue/*
01_ingest/processing/*
01_ingest/renamed/*
01_ingest/rejected/*
10_knowledge/*
!10_knowledge/index.template.md
!10_knowledge/AGENTS.md
20_live/*
!20_live/index.md
!20_live/AGENTS.md
30_projects/*
!30_projects/index.template.md
!30_projects/AGENTS.md
40_operations/*
